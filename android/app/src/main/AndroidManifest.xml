<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlaces del widget: andamia://hoy, andamia://nueva, andamia://tarea/ID -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="andamia" />
            </intent-filter>
        </activity>

        <!-- Widget "Hoy" de la pantalla de inicio -->
        <receiver
            android:name=".HoyWidget"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hoy_info" />
        </receiver>

        <!-- Widgets Semana, Matriz, Calendario y estadísticas -->
        <receiver
            android:name=".WidgetSemana"
            android:exported="true"
            android:label="@string/widget_semana_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_semana_info" />
        </receiver>

        <receiver
            android:name=".WidgetMatriz"
            android:enabled="false"
            android:exported="true"
            android:label="@string/widget_matriz_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_matriz_info" />
        </receiver>

        <receiver
            android:name=".WidgetCalendario"
            android:exported="true"
            android:label="@string/widget_calendario_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_calendario_info" />
        </receiver>

        <receiver
            android:name=".WidgetEstadisticaTareas"
            android:exported="true"
            android:label="@string/widget_estadistica_tareas_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_estadistica_tareas_info" />
        </receiver>

        <receiver
            android:name=".WidgetEstadisticaHabitos"
            android:exported="true"
            android:label="@string/widget_estadistica_habitos_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_estadistica_habitos_info" />
        </receiver>

        <service
            android:name=".ServicioFilas"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".ServicioListaHoy"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <activity
            android:name=".AccionWidgetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Cuadro rápido del "+" de los widgets: se escribe sobre la pantalla de inicio. -->
        <activity
            android:name=".NuevaRapidaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="cl.andamia.app.rapida"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
