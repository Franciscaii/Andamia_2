<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Semana" del celular, como la vista Día de la app: arriba el mes con flechas,
  los filtros y el "+"; luego la tira de días; abajo los eventos y las tarjetas del día elegido.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo con el tema, la transparencia y las esquinas de este widget (lo dibuja TemaWidget). -->
    <ImageView
        android:id="@+id/fondo_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fondo" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/semana_atras"
            android:layout_width="24dp"
            android:layout_height="32dp"
            android:contentDescription="Semana anterior"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/widget_texto"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/semana_mes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Nov"
            android:textColor="@color/widget_texto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/semana_adelante"
            android:layout_width="24dp"
            android:layout_height="32dp"
            android:contentDescription="Semana siguiente"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/widget_texto"
            android:textSize="22sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/semana_filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_filtros"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/semana_f_tareas"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Tareas"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_f_eventos"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Eventos"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_f_habitos"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Hábitos"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_f_todos"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Todos"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/semana_nueva"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_boton"
            android:contentDescription="Nueva tarea"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_boton_texto"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/semana_dia_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_0"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/semana_dia_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/semana_dia_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/semana_dia_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/semana_dia_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_4"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/semana_dia_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_5"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/semana_dia_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/semana_nom_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/semana_num_6"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textColor="@color/widget_texto"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/semana_pto_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:text="•"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp">

        <!-- Eventos y tarjetas (Tareas hoy, Completadas) del día elegido. -->
        <ListView
            android:id="@+id/semana_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <TextView
            android:id="@+id/semana_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Nada este día.\nToca aquí para abrir Andamia."
            android:textColor="@color/widget_texto_tenue"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
</FrameLayout>
