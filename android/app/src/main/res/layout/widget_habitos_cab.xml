<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera del desplegable de hábitos del widget Semana: "Hábitos 5" y una flecha. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/cab_fila"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_oval"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/cab_titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_texto"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cab_flecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_texto"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
