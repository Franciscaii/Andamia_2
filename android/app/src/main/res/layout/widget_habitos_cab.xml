<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera del desplegable de hábitos del widget Semana: llama, "Hábitos" y la flecha en su círculo, como en la app.
     OJO: sin paddingStart/paddingEnd en la raíz: el fondo de la tarjeta (widget_tarjeta_*) trae su propio margen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cab_fila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/cab_icono"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_llama" />

    <TextView
        android:id="@+id/cab_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/widget_texto"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/cab_flecha"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_circulo"
        android:contentDescription="Mostrar u ocultar los hábitos"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chevron_arriba" />
</LinearLayout>
