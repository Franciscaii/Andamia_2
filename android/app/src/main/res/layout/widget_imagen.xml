<?xml version="1.0" encoding="utf-8"?>
<!-- Calendario y estadísticas: la app los dibuja como imagen (ver Dibujos.java). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo con el color del tema, la transparencia y las esquinas elegidas (lo dibuja TemaWidget). -->
    <ImageView
        android:id="@+id/fondo_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fondo" />

    <ImageView
        android:id="@+id/imagen_vista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Abrir en Andamia"
        android:scaleType="fitXY" />

    <!-- Estadísticas: zonas invisibles sobre cada fila de la leyenda, para destacar esa etiqueta al tocarla. -->
    <FrameLayout
        android:id="@+id/est_zona_0"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_1"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_2"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_3"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_4"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_5"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_6"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/est_zona_7"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Destacar esta etiqueta"
        android:visibility="gone" />
</FrameLayout>
