<?xml version="1.0" encoding="utf-8"?>
<!-- Una tarea: casilla (pegada a la izquierda, bajo el título de su tarjeta) con el color de la importancia, título, dificultad y etiqueta. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fila_raiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/fila_circulo"
        android:layout_width="32dp"
        android:layout_height="48dp"
        android:contentDescription="Marcar como hecha"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:paddingEnd="10dp"
        android:scaleType="fitStart"
        android:src="@drawable/casilla_vacia" />

    <LinearLayout
        android:id="@+id/fila_texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/fila_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_texto"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/fila_importancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_insignia"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fila_detalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_texto_tenue"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/fila_etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:background="@drawable/widget_etiqueta"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="110dp"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
