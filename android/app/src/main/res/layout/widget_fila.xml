<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/fila_circulo"
        android:layout_width="40dp"
        android:layout_height="44dp"
        android:contentDescription="Marcar como hecha"
        android:gravity="center"
        android:text="○"
        android:textColor="@color/widget_texto_tenue"
        android:textSize="22sp" />

    <LinearLayout
        android:id="@+id/fila_texto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/fila_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_texto"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/fila_detalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_texto_tenue"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
