<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Calendario" del celular, como la vista Calendario de la app: arriba el mes con flechas,
  los filtros y el "+"; abajo el mes dibujado como imagen (ver Dibujos.calendario).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo con el tema, la transparencia y las esquinas de este widget (lo dibuja TemaWidget). -->
    <ImageView
        android:id="@+id/fondo_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fondo" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cal_atras"
            android:layout_width="24dp"
            android:layout_height="36dp"
            android:contentDescription="Mes anterior"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/widget_texto"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/cal_mes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="NOV"
            android:textColor="@color/widget_texto"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cal_adelante"
            android:layout_width="24dp"
            android:layout_height="36dp"
            android:contentDescription="Mes siguiente"
            android:gravity="center"
            android:text="›"
            android:textColor="@color/widget_texto"
            android:textSize="28sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/cal_filtros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_filtros"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/cal_f_habitos"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Hábitos"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cal_f_tareas"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Tareas"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cal_f_eventos"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Eventos"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cal_f_todos"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="Todos"
                android:textColor="@color/widget_texto"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/cal_nueva"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_boton"
            android:contentDescription="Nueva tarea"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_boton_texto"
            android:textSize="22sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/cal_imagen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:contentDescription="Abrir el calendario en Andamia"
        android:scaleType="fitXY" />
</LinearLayout>
</FrameLayout>
