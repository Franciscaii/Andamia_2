<?xml version="1.0" encoding="utf-8"?>
<!-- Un evento: franja con su color (morado por defecto), sin casilla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/evento_fila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_evento"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingEnd="10dp">

    <View
        android:id="@+id/evento_color"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@color/widget_evento" />

    <TextView
        android:id="@+id/evento_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_texto"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/evento_hora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_texto_tenue"
        android:textSize="12sp" />
</LinearLayout>
