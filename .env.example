# Copia este archivo como .env.local y completa los valores de tu proyecto Firebase.
# Sin estos valores, Andamia funciona igual, pero sin cuentas ni sincronización.
# La guía está en docs/firebase-paso-a-paso.md

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional. Clave pública VAPID de Cloud Messaging. Solo sirve si algún día hay un
# servidor que envíe los avisos: en el plan gratuito no hay envío programado.
VITE_FIREBASE_VAPID_KEY=

# Opcional. Recordatorios de tareas y hábitos: apagados salvo que pongas "si".
# VITE_RECORDATORIOS=si

# Solo para desarrollo: usa los emuladores locales en vez del proyecto real.
# VITE_FIREBASE_EMULADORES=si

# Volver a mostrar el botón para crear listas y carpetas en el menú
# VITE_LISTAS=si
